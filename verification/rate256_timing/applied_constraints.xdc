####################################################################################
# Constraints from file : 'timing_harness_100mhz.xdc'
####################################################################################

# Clocked launch/capture FFs provide the actual synchronous core context.
create_clock -period 10.000 -name core_clk [get_ports clk]
set_clock_uncertainty 0.100 [get_clocks core_clk]
# Only measurement outputs leave the fixture; production core ports are
# routed between placed registers. These output budgets are not board claims.
set _xlnx_shared_i0 [all_outputs]
set_output_delay -clock core_clk -max 2.000 $_xlnx_shared_i0
set_output_delay -clock core_clk -min 0.500 $_xlnx_shared_i0


####################################################################################
# Constraints from file : 'timing_harness_context.xdc'
####################################################################################

# A real BUFG is instantiated inside this verification fixture.
set_property LOC BUFGCTRL_X0Y0 [get_cells core_clock_buffer]


# Vivado Generated miscellaneous constraints 

#revert back to original instance
current_instance -quiet
